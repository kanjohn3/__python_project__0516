   "source": [
    "#學生總分為300\n",
    "#有些學生可以加5%\n",
    "\n",
    "score = int(input(\"請輸入學生的分數(最高300分)：\"))\n",
    "bonus = input(\"學生是否符合加分條件?(Y/N)：\")\n",
    "\n",
    "if bonus == \"Y\": #單項選擇\n",
    "    score = score * 1.05\n",
    "\n",
    "print(\"學生的總分為：\", round(score))  \n"
   ]
  }
 ],
